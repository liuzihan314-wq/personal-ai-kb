# Copy this file to .env and replace only the API key with your own secret.
# The implementation accepts any OpenAI-compatible chat-completions endpoint.
# DeepSeek's official API root is https://api.deepseek.com.
PKB_AI_PROVIDER=deepseek
PKB_AI_MODEL=deepseek-v4-flash
PKB_AI_BASE_URL=https://api.deepseek.com
PKB_AI_API_KEY=
