# Copy this file to .env and replace only the API key with your own secret.
# The implementation accepts any OpenAI-compatible chat-completions endpoint.
# DeepSeek's official API root is https://api.deepseek.com.
PKB_AI_PROVIDER=deepseek
PKB_AI_MODEL=deepseek-v4-flash
PKB_AI_BASE_URL=https://api.deepseek.com
PKB_AI_API_KEY=

# Optional semantic retrieval. Leave all three empty to use direct retrieval only.
PKB_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
PKB_EMBEDDING_BASE_URL=
PKB_EMBEDDING_API_KEY=

# Optional V2 authentication.  Keep disabled for V1 local single-user mode.
# mode=cloudflare uses Cloudflare Access JWT headers; mode=local uses local accounts.
PKB_AUTH_ENABLED=false
PKB_AUTH_MODE=cloudflare
PKB_AUTH_LOCAL_USERS_FILE=config/local_users.json
PKB_AUTH_ISSUER=
PKB_AUTH_AUDIENCE=
# Optional; when empty, the adapter derives the official Access cert endpoint from issuer.
PKB_AUTH_JWKS_URL=
# Semicolon-separated protected mappings, for example: <access-sub>=admin;<access-sub>=member
PKB_AUTH_ROLE_MAPPING=
